---
const year = new Date().getFullYear();
const email = "hello@francoispeyret.fr";
const socials = [
  { label: "GitHub", url: "https://github.com/francoispeyret" },
  { label: "LinkedIn", url: "https://www.linkedin.com/in/fpeyret/" },
];
---

<section class="about" id="about">
  <header class="head">
    <p class="mono label">§ 03 — About / Contact</p>
  </header>

  <div class="content">
    <article class="story">
      <h2 class="story-title serif">
        <span>Développeur</span><br />
        <span class="outline">qui fabrique.</span>
      </h2>

      <div class="prose serif">
        <p>
          Je m'appelle <strong>François Peyret</strong>, je vis et travaille
          en France, quelque part entre <span class="hl">Auvergne et Loire</span>.
        </p>
        <p>
          Depuis plus de dix ans, je conçois et j'intègre des boutiques en
          ligne — Shopify, PrestaShop, et tout ce qui se passe autour
          (intégration, performance, maintenance, parfois du back).
        </p>
        <p>
          J'aime les sites <em>solides</em>, propres dans le code, lisibles
          dans le navigateur, et qui ne tombent pas en panne le dimanche soir.
          Le reste du temps : 3D dans Blender, photo, typographie, et
          quelques pages de print quand l'envie passe.
        </p>
        <p class="mono small">
          ⏵ Disponible pour des missions freelance et collaborations longues.
        </p>
      </div>
    </article>

    <aside class="contact">
      <p class="mono kicker">→ Tu veux qu'on travaille ensemble ?</p>

      <a class="email serif" href={`mailto:${email}`}>
        <span class="email-text">{email}</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <ul class="socials mono">
        {socials.map((s, i) => (
          <li>
            <span class="social-n">0{i + 1}</span>
            <a href={s.url} target="_blank" rel="noopener noreferrer">
              {s.label}
              <span aria-hidden="true">&nbsp;↗</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="coords mono">
        <span>Aurec-sur-Loire</span>
        <span class="sep">/</span>
        <span>France</span>
        <span class="sep">/</span>
        <span>UTC+1</span>
      </div>
    </aside>
  </div>

  <footer class="colophon mono">
    <span>© François Peyret — {year}</span>
    <span class="middle">Fait à la main avec Astro et du café.</span>
    <a href="#hero" class="back">↑ Retour en haut</a>
  </footer>
</section>

<style>
  .about {
    background: var(--bg);
    position: relative;
    z-index: 1;
  }

  .head {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 5rem);
    border-top: 2px solid var(--ink);
    padding-top: clamp(2rem, 4vw, 3rem);
  }

  .story-title {
    font-style: italic;
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .story-title .outline {
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    padding-left: clamp(1.5rem, 4vw, 3.5rem);
  }

  .prose {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.45;
    max-width: 42ch;
    display: flex;
    flex-direction: column;
    gap: 1.1em;
  }

  .prose strong {
    font-weight: 900;
  }

  .prose em {
    background: var(--accent);
    color: var(--bg);
    padding: 0 0.25em;
    font-style: italic;
  }

  .hl {
    border-bottom: 2px solid var(--accent);
  }

  .small {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px dashed var(--ink);
    padding-top: 1rem;
    margin-top: 0.5rem;
  }

  .contact {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .kicker {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .email {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-style: italic;
    font-weight: 900;
    font-size: clamp(1.4rem, 2.9vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: clamp(1rem, 2vw, 1.5rem) 0;
    transition: color 0.25s ease, padding 0.3s ease;
    position: relative;
    overflow: hidden;
    word-break: break-all;
  }

  .email::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.35s cubic-bezier(0.6, 0, 0.2, 1);
    z-index: 0;
  }

  .email > * {
    position: relative;
    z-index: 1;
  }

  .email:hover::before {
    transform: scaleY(1);
  }

  .email:hover {
    color: var(--bg);
    padding-left: clamp(0.5rem, 1.5vw, 1rem);
    padding-right: clamp(0.5rem, 1.5vw, 1rem);
  }

  .email-text {
    min-width: 0;
    flex: 1;
  }

  .email .arrow {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1;
    display: inline-block;
    transition: transform 0.3s ease, color 0.25s ease;
  }

  .email:hover .arrow {
    color: var(--accent);
    transform: rotate(-45deg) translateX(0.15em);
  }

  .socials {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .socials li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.5rem 0;
    border-bottom: 1px dashed var(--ink);
  }

  .socials li:last-child {
    border-bottom: none;
  }

  .social-n {
    color: var(--accent);
  }

  .socials a {
    transition: color 0.2s ease, padding 0.25s ease;
  }

  .socials a:hover {
    color: var(--accent);
    padding-left: 0.5rem;
  }

  .coords {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px dashed var(--ink);
    padding-top: 1rem;
  }

  .sep {
    opacity: 0.5;
  }

  .colophon {
    margin-top: clamp(3rem, 6vw, 5rem);
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .middle {
    flex: 1;
    text-align: center;
    min-width: 200px;
  }

  .back {
    transition: color 0.2s ease;
  }

  .back:hover {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .content {
      grid-template-columns: 1fr;
    }
    .colophon {
      flex-direction: column;
      align-items: flex-start;
    }
    .middle {
      text-align: left;
    }
  }
</style>
